# Configuração do Groq
LLM_API_KEY=coloque_sua_chave_aqui
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_OUTPUT_MODE=structured

# Tempo limite e recuperação de falhas
LLM_TIMEOUT=30
LLM_MAX_RETRIES=0
LLM_MAX_RATE_LIMIT_WAIT_SECONDS=60

# Limites de uso do Groq (ajuste conforme sua conta)
GROQ_ORGANIZATION=default
GROQ_RPM=30
GROQ_TPM=8000
GROQ_ADMISSION_TIMEOUT_SECONDS=60

# Configurações do modelo
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_REASONING_EFFORT=low

# Diretório dos dados (opcional)
# DATA_DIR=./data

# Limites específicos por modelo (opcional)
# GROQ_RATE_LIMITS_JSON='{"default":{"openai/gpt-oss-20b":{"rpm":30,"tpm":8000}}}'